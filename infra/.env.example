# Droplet-only. Copied to infra/.env on first deploy (see infra/compose.yml,
# which auto-loads .env from this directory since it's the compose project
# directory). infra/.env itself is gitignored and never overwritten by a
# later deploy — see specs/lanes/deployment.md.
#
# Generate JWT_SECRET with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Never copy the value from the repo-root .env.example or compose.yml —
# a signing secret shared between local dev and production means locally
# minted sessions would be valid on the live URL.
JWT_SECRET=

# Optional — defaults to mp_session if unset, matching local dev.
COOKIE_NAME=

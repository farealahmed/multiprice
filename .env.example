# Server
PORT=3001
NODE_ENV=development

# Mongo
MONGO_URL=mongodb://localhost:27017
MONGO_DB=multiprice

# Auth — Phase 2 fills JWT_SECRET at deploy time; declared here so compose never changes.
JWT_SECRET=
COOKIE_NAME=mp_session

# Same-origin proxy: Next rewrites /api/:path* to ${BACKEND_ORIGIN}/api/:path*
# Host-process dev: backend listens on 3001 on the host.
# In the reviewer's compose stack: BACKEND_ORIGIN=http://backend:3001 (compose DNS).
BACKEND_ORIGIN=http://localhost:3001